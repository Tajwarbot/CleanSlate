{
  "name": "cleanslate",
  "version": "0.1.1",
  "private": true,
  "description": "Privacy-first browser extension for managing and removing your own Facebook and Messenger activity",
  "author": "CleanSlate Contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "echo \"E2E tests will be configured in Phase 8\" && exit 0",
    "audit": "npm audit",
    "package": "npm run build && node scripts/package.mjs",
    "launch": "pwsh -ExecutionPolicy Bypass -File scripts/install-direct.ps1",
    "start": "pwsh -ExecutionPolicy Bypass -File scripts/install-direct.ps1",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/chrome": "^0.0.312",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
